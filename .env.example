# JarvisLabs: the CLI reads JL_API_KEY. JARVIS_API is accepted by our scripts as an alias.
JL_API_KEY=
JARVIS_API=

# Context.dev (dataset discovery)
CONTEXT_DEV_API_KEY=

# Boat (control-plane sandbox)
BOAT_API_KEY=
BOAT_SANDBOX_ID=bx_6nvrrech

# Feature flags (1/0). Missing key → integration is off, demo still runs.
COGNEE_ENABLED=1
SINGLESTORE_ENABLED=0
AIRBYTE_ENABLED=0
AMPLITUDE_ENABLED=0
STATSIG_ENABLED=0
SUPERLINKED_ENABLED=0
WHISPER_GPU_FALLBACK=0
WARM_RESUME_ENABLED=1
BUDGET_CAP_INR=150

# Cognee (local SDK; no key needed for GLiNER/lexical)
LLM_API_KEY=
TELEMETRY_DISABLED=true

# SingleStore (MySQL wire)
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=vibetuning

# Amplitude HTTP v2
AMPLITUDE_API_KEY=

# Statsig server secret — reads warm_resume_enabled + budget_cap_inr
STATSIG_SDK_KEY=
STATSIG_WARM_RESUME_GATE=warm_resume_enabled
STATSIG_BUDGET_CONFIG=budget_cap_inr

# Superlinked SIE Serverless (stretch)
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
